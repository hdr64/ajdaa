{
  "name": "ajda-server",
  "version": "1.2.3",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "postinstall": "prisma generate",
    "db:gen:prod": "node scripts/generate-prod-schema.mjs && prisma generate --schema prisma/schema.postgresql.prisma",
    "db:sync-data": "node scripts/sync-data.mjs",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate deploy --schema prisma/schema.postgresql.prisma",
    "db:seed": "tsx prisma/seed.ts",
    "user:create-dev": "tsx scripts/create-dev-user.ts",
    "db:studio": "prisma studio",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/jwt": "^10.2.5",
    "@fastify/multipart": "^9.0.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.7",
    "@prisma/adapter-better-sqlite3": "^7.10.1",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@simplewebauthn/server": "^14.0.3",
    "bcryptjs": "^3.0.2",
    "bullmq": "^6.3.10",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "ioredis": "^6.0.0",
    "nodemailer": "^10.0.12",
    "pg": "^8.13.1",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.13.4",
    "@types/nodemailer": "^8.0.2",
    "prisma": "^7.10.1",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^5.0.2"
  },
  "allowScripts": {
    "sharp@0.33.5": true,
    "esbuild@0.28.2": true,
    "@prisma/client@7.10.1": true,
    "better-sqlite3@12.11.1": true,
    "msgpackr-extract@3.0.4": true,
    "@prisma/engines@7.10.1": true,
    "prisma@7.10.1": true
  }
}
