{
  "name": "ajda-server",
  "version": "1.2.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "postinstall": "prisma generate",
    "db:gen:prod": "node scripts/generate-prod-schema.mjs && prisma generate --schema prisma/schema.postgresql.prisma",
    "db:sync-data": "node scripts/sync-data.mjs",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate deploy --schema prisma/schema.postgresql.prisma",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/jwt": "^9.0.1",
    "@fastify/multipart": "^9.0.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^8.0.2",
    "@prisma/client": "^6.4.1",
    "bcryptjs": "^3.0.2",
    "bullmq": "^6.3.10",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "ioredis": "^6.0.0",
    "nodemailer": "^10.0.12",
    "sharp": "^0.33.5",
    "socket.io": "^4.8.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.13.4",
    "@types/nodemailer": "^8.0.2",
    "prisma": "^6.4.1",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^5.0.2"
  },
  "allowScripts": {
    "sharp@0.33.5": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.2": true,
    "@prisma/client@6.19.3": true,
    "msgpackr-extract@3.0.4": true,
    "prisma@6.19.3": true
  }
}
