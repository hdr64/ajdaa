# ===============================
# Ajda API — environment example
# Copy to server/.env and adjust.
# ===============================

# --- Database ---
# DEV: SQLite (used by schema.prisma + `npm run db:push`).
DATABASE_URL="file:./dev.db"
# PROD: PostgreSQL 16 (used by prisma/schema.postgresql.prisma + `npm run db:migrate`).
# DATABASE_URL="postgresql://ajda:CHANGE_ME@localhost:5432/ajda?schema=public"

# --- Server ---
PORT=4000
# The address the API binds to.
# 127.0.0.1 keeps a development server off the network (the default) and is
# correct in production when Caddy/nginx runs on the same host: the proxy
# reaches the API over the loopback interface.
# Bind 0.0.0.0 only when the proxy runs on ANOTHER machine, otherwise the API
# is exposed on the network.
HOST="127.0.0.1"

# --- Security ---
# Production MUST set a long random value (e.g. `openssl rand -base64 32`),
# and it must be at least 32 characters: the server refuses to start in
# production with a shorter value or with a placeholder.
JWT_SECRET="ajda_secret_development_key_super_secure_2026"

# Comma-separated list of allowed browser origins.
CLIENT_ORIGIN="http://localhost:5173"

# Whether the API trusts the X-Forwarded-* headers of a reverse proxy.
# false            = trust nothing (the default: a client could otherwise
#                    spoof its own IP and bypass the rate limits).
# true / "1"       = trust every proxy hop ("1" is read as "true").
# <number>         = trust exactly that many hops, counted from the API's own
#                    connection outwards: use the number of proxies in front
#                    of the API ("2" for two proxies).
# A production deployment behind Caddy must set this to "1", otherwise every
# request looks like it comes from the proxy itself and the per-IP rate limits
# and lockouts would apply to all visitors at once.
TRUST_PROXY="false"

# --- Media ---
UPLOAD_DIR="./uploads"
PRIVATE_DIR="./private"
# --- Email (SMTP) ---
# Leave MAIL_HOST empty to run with email disabled: the API still boots and
# every send becomes a logged no-op. Never commit real credentials.
MAIL_HOST=""
MAIL_PORT=587
MAIL_USERNAME=""
MAIL_PASSWORD=""
# tls = STARTTLS (typical for port 587) | ssl = implicit TLS (port 465) | none = plaintext
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=""
# Brand name shown as the sender, and the heading of every email.
MAIL_FROM_NAME="Ajda"

# Absolute base for links inside emails (e.g. the admin inquiries page).
APP_URL="https://ajda.weghetk.com"

# --- Email OTP ---
# true  = every admin login requires a one-time code sent by email.
# false = only accounts with loginOtpEnabled (settable via PATCH /api/auth/me/login-otp).
LOGIN_OTP_REQUIRED="false"
# Code lifetime, wrong-code attempts per challenge, minimum gap between resends.
LOGIN_OTP_TTL_MS=600000
LOGIN_OTP_MAX_ATTEMPTS=5
LOGIN_OTP_RESEND_COOLDOWN_MS=60000

# --- New-inquiry notifications ---
# Comma-separated allowlist. Empty = every active admin with `viewInquiries`.
NOTIFY_INQUIRY_EMAILS=""

# --- Production Logs & Monitoring ---
# Path to production log file (gitignored).
LOG_FILE_PATH="./prod.log"
# Path to dedicated errors log file (gitignored).
ERROR_LOG_FILE_PATH="./errors.log"
# Shared secret for the log endpoints. It is the second factor on top of a
# super admin session and is only accepted in the `x-logs-key` header
# (a query parameter would end up in access logs and browser history).
# REQUIRED in production (at least 24 characters, e.g. `openssl rand -base64 32`).
# Unset outside production it becomes a random per-process value, so the log
# endpoints are reachable only with an authenticated super admin.
LOGS_SECRET_KEY=""
# Set to 'true' to allow public read access to logs without credentials.
# This disables the super admin + key requirement entirely — leave it "false"
# on any deployment that is reachable from the internet.
LOGS_PUBLIC="false"

# --- Developer Notes & Bug Reports ---
# Target email(s) for immediate notifications when a developer note is
# submitted. Comma-separated. There is no default: the address belongs to the
# deployment.
DEVELOPER_EMAIL=""
# Shared secret for the developer-notes management endpoints. Same rules as
# LOGS_SECRET_KEY, and it is only accepted in the `x-dev-notes-key` header.
# REQUIRED in production (at least 24 characters).
DEVELOPER_NOTES_SECRET=""

# --- Asynchronous Job Queue ---
# Redis connection for BullMQ. Ignored when QUEUE_DRIVER=sync.
REDIS_URL="redis://127.0.0.1:6379"
# auto  = probe Redis, fall back to inline execution when unreachable (default).
# redis = require Redis; boot fails instead of degrading silently. Use in production.
# sync  = never probe; always run jobs inline in the request.
QUEUE_DRIVER="auto"