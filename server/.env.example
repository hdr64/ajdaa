# ===============================
# Ajda API — environment example
# Copy to server/.env and adjust.
# ===============================

# --- Database ---
# DEV: SQLite (used by schema.prisma + `npm run db:push`).
DATABASE_URL="file:./dev.db"
# PROD: PostgreSQL 16 (used by prisma/schema.postgresql.prisma + `npm run db:migrate`).
# DATABASE_URL="postgresql://ajda:CHANGE_ME@localhost:5432/ajda?schema=public"

# --- Server ---
PORT=4000

# --- Security ---
# Production MUST set a long random value (e.g. `openssl rand -base64 32`).
JWT_SECRET="ajda_secret_development_key_super_secure_2026"

# Comma-separated list of allowed browser origins.
CLIENT_ORIGIN="http://localhost:5173"

# --- Media ---
UPLOAD_DIR="./uploads"

# --- Email (SMTP) ---
# Leave MAIL_HOST empty to run with email disabled: the API still boots and
# every send becomes a logged no-op. Never commit real credentials.
MAIL_HOST=""
MAIL_PORT=587
MAIL_USERNAME=""
MAIL_PASSWORD=""
# tls = STARTTLS (typical for port 587) | ssl = implicit TLS (port 465) | none = plaintext
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=""
# Brand name shown as the sender, and the heading of every email.
MAIL_FROM_NAME="Ajda"

# Absolute base for links inside emails (e.g. the admin inquiries page).
APP_URL="https://ajda.weghetk.com"

# --- Email OTP ---
# true  = every admin login requires a one-time code sent by email.
# false = only accounts with loginOtpEnabled (settable via PATCH /api/auth/me/login-otp).
LOGIN_OTP_REQUIRED="false"
# Code lifetime, wrong-code attempts per challenge, minimum gap between resends.
LOGIN_OTP_TTL_MS=600000
LOGIN_OTP_MAX_ATTEMPTS=5
LOGIN_OTP_RESEND_COOLDOWN_MS=60000

# --- New-inquiry notifications ---
# Comma-separated allowlist. Empty = every active admin with `viewInquiries`.
NOTIFY_INQUIRY_EMAILS=""

# --- Production Logs & Monitoring ---
# Path to production log file (gitignored).
LOG_FILE_PATH="./prod.log"
# Path to dedicated errors log file (gitignored).
ERROR_LOG_FILE_PATH="./errors.log"
# Secret key used for authenticating log queries via `?key=` or `x-logs-key` header.
LOGS_SECRET_KEY="ajda-logs-secret-2026"
# Set to 'true' to allow public read access to logs without credentials.
LOGS_PUBLIC="false"

# --- Developer Notes & Bug Reports ---
# Target email(s) for immediate notifications when a developer note is submitted.
DEVELOPER_EMAIL="cloud.data.sa@gmail.com"
# Secret key for developer API access via `?key=` or `x-developer-key` header.
DEVELOPER_NOTES_SECRET="ajda-dev-notes-2026"