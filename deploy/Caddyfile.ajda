# PRODUCTION only (ajdaa.sa). Installed as /etc/caddy/Caddyfile.ajda and pulled
# into the server's main Caddyfile with ONE line:
#
#     import /etc/caddy/Caddyfile.ajda
#
# Site blocks only: global options live in the main /etc/caddy/Caddyfile, which
# is owned by hand and never overwritten from this repo. The test instance has
# its own file, Caddyfile.test.ajda.
#
# Install / update:
#   diff -u /etc/caddy/Caddyfile.ajda deploy/Caddyfile.ajda     # read it first
#   sudo cp deploy/Caddyfile.ajda /etc/caddy/Caddyfile.ajda
#   sudo caddy validate --config /etc/caddy/Caddyfile
#   sudo systemctl reload caddy

# Production. SPA served from /srv/ajda/app/dist (deploy/README-deploy.md §6.1).
# TLS: Caddy obtains the ajdaa.sa certificate itself.
ajdaa.sa {
	encode zstd gzip

	# --- API: JSON, auth, inquiries ---
	handle /api/* {
		reverse_proxy 127.0.0.1:4000
	}

	# --- Uploaded media (WebP images, PDF brochures) ---
	handle /uploads/* {
		reverse_proxy 127.0.0.1:4000
	}

	# --- Socket.io realtime ---
	# The websocket upgrade must reach the API; no buffering here.
	handle /socket.io/* {
		reverse_proxy 127.0.0.1:4000 {
			flush_interval -1
		}
	}

	# --- Search-engine files (generated by the API; see docs/architecture.md "SEO shell") ---
	handle /robots.txt {
		reverse_proxy 127.0.0.1:4000
	}
	handle /sitemap.xml {
		reverse_proxy 127.0.0.1:4000
	}

	# --- SPA pages: the API renders index.html with per-page meta tags (title, OG, JSON-LD).
	# Paths with a file extension and anything under /assets are plain static files.
	# If the API answers 5xx or is down, handle_errors below serves the static index.html.
	@spaPage {
		not path /assets/* /uploads/* /socket.io/* /api/*
		not path_regexp \.[A-Za-z0-9]+$
	}
	handle @spaPage {
		rewrite * /api/seo/shell?path={http.request.uri.path}
		reverse_proxy 127.0.0.1:4000 {
			@shellFailed status 5xx 429
			handle_response @shellFailed {
				rewrite * /index.html
				root * /srv/ajda/app/dist
				header Cache-Control "no-cache, no-store, must-revalidate"
				file_server
			}
		}
	}

	# --- SPA ---
	handle {
		root * /srv/ajda/app/dist

		# Hashed asset filenames are safe to cache aggressively.
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"

		# index.html must never be cached, or clients pin to a stale bundle.
		@index path /index.html
		header @index Cache-Control "no-cache, no-store, must-revalidate"

		# Client-side routing: unknown paths render the SPA shell.
		try_files {path} /index.html
		file_server
	}

	# API unreachable (restart, crash): serve the static shell for page URLs only.
	# {http.request.orig_uri.path} is the URL before the rewrite to /api/seo/shell.
	handle_errors {
		@spaDown expression `{http.error.status_code} >= 500 && !{http.request.orig_uri.path}.startsWith("/api/") && !{http.request.orig_uri.path}.startsWith("/uploads/") && !{http.request.orig_uri.path}.startsWith("/socket.io/")`
		handle @spaDown {
			rewrite * /index.html
			root * /srv/ajda/app/dist
			header Cache-Control "no-cache, no-store, must-revalidate"
			file_server
		}
	}

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		-Server
	}

	log {
		output file /var/log/caddy/ajda-access.log {
			roll_size 20MiB
			roll_keep 10
		}
	}
}
