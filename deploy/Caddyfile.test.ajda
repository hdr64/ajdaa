# TEST instance only (ajda.weghetk.com). Installed as /etc/caddy/Caddyfile.test.ajda
# and pulled into the server's main Caddyfile with ONE line:
#
#     import /etc/caddy/Caddyfile.test.ajda
#
# Site blocks only: global options live in the main /etc/caddy/Caddyfile, which
# is owned by hand and never overwritten from this repo.
#
# Install / update:
#   diff -u /etc/caddy/Caddyfile.test.ajda deploy/Caddyfile.test.ajda   # read it first
#   sudo cp deploy/Caddyfile.test.ajda /etc/caddy/Caddyfile.test.ajda
#   sudo caddy validate --config /etc/caddy/Caddyfile
#   sudo systemctl reload caddy
#
# ajda.weghetk.com used to be a second name for production; it now serves the
# test instance (port 4001, /srv/ajda/test).

# TEST instance: one port and one checkout away from production.
# TLS: the Cloudflare origin certificate that already serves ajda.weghetk.com.
# Caddy serves the SPA straight from the test checkout, so the deploy swap
# (dist -> dist.old, dist.new -> dist) takes effect without a copy step.
ajda.weghetk.com {
	tls /etc/caddy/ajda-origin.pem /etc/caddy/ajda-origin.key
	encode zstd gzip

	# No basic auth: the test site is reachable without a password. Keep real
	# personal data out of the test database (deploy/sanitize-test-db.sql).

	# Keep the test instance out of the search engines.
	header X-Robots-Tag "noindex, nofollow"

	handle /api/* {
		reverse_proxy 127.0.0.1:4001
	}

	handle /uploads/* {
		reverse_proxy 127.0.0.1:4001
	}

	handle /socket.io/* {
		reverse_proxy 127.0.0.1:4001 {
			flush_interval -1
		}
	}

	# --- Search-engine files (generated by the API; see docs/architecture.md "SEO shell") ---
	handle /robots.txt {
		reverse_proxy 127.0.0.1:4001
	}
	handle /sitemap.xml {
		reverse_proxy 127.0.0.1:4001
	}

	# --- SPA pages: the API renders index.html with per-page meta tags (title, OG, JSON-LD).
	# Paths with a file extension and anything under /assets are plain static files.
	# If the API answers 5xx or is down, handle_errors below serves the static index.html.
	@spaPage {
		not path /assets/* /uploads/* /socket.io/* /api/*
		not path_regexp \.[A-Za-z0-9]+$
	}
	handle @spaPage {
		rewrite * /api/seo/shell?path={http.request.uri.path}
		reverse_proxy 127.0.0.1:4001 {
			@shellFailed status 5xx 429
			handle_response @shellFailed {
				rewrite * /index.html
				root * /srv/ajda/test/dist
				header Cache-Control "no-cache, no-store, must-revalidate"
				file_server
			}
		}
	}

	handle {
		root * /srv/ajda/test/dist

		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"

		@index path /index.html
		header @index Cache-Control "no-cache, no-store, must-revalidate"

		try_files {path} /index.html
		file_server
	}

	# API unreachable (restart, crash): serve the static shell for page URLs only.
	# {http.request.orig_uri.path} is the URL before the rewrite to /api/seo/shell.
	handle_errors {
		@spaDown expression `{http.error.status_code} >= 500 && !{http.request.orig_uri.path}.startsWith("/api/") && !{http.request.orig_uri.path}.startsWith("/uploads/") && !{http.request.orig_uri.path}.startsWith("/socket.io/")`
		handle @spaDown {
			rewrite * /index.html
			root * /srv/ajda/test/dist
			header Cache-Control "no-cache, no-store, must-revalidate"
			file_server
		}
	}

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		-Server
	}

	log {
		output file /var/log/caddy/ajda-test-access.log {
			roll_size 20MiB
			roll_keep 10
		}
	}
}
