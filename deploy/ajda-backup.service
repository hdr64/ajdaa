[Unit]
Description=Nightly Ajda PostgreSQL backup
Documentation=file:/srv/ajda/app/server/scripts/backup_db.sh
After=postgresql.service
Requires=postgresql.service

[Service]
Type=oneshot
User=salah
Group=salah
WorkingDirectory=/srv/ajda/app/server

# Secrets live here, not in the app's .env. The file must exist (mode 600).
EnvironmentFile=/srv/ajda/app/server/.env.backup

ExecStart=/srv/ajda/app/server/scripts/backup_db.sh

# A failed backup must be visible, not silently retried forever.
SuccessExitStatus=0
TimeoutStartSec=30min

# --- Hardening ---
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=full
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

# The dump directory (and the uploads mirror inside it) are writable.
ReadWritePaths=/var/backups/ajda

StandardOutput=journal
StandardError=journal
SyslogIdentifier=ajda-backup
