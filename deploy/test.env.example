# Test instance environment template.
#
#   cp deploy/test.env.example /srv/ajda/test/server/.env
#   chmod 600 /srv/ajda/test/server/.env
#
# Never commit the real file: only this template belongs in git.
# Placeholders marked <...> must be replaced before the service starts.
#
# NODE_ENV=production makes the server REFUSE TO BOOT unless these secrets
# are set (the rules live in server/src/config/env.ts):
#   JWT_SECRET             at least 32 characters and not a placeholder
#                          ("change me", "secret", "password", ... are refused)
#   LOGS_SECRET_KEY        at least 24 characters
#   DEVELOPER_NOTES_SECRET at least 24 characters
# Generate each one separately with: openssl rand -base64 32

NODE_ENV=production
PORT=4001
# The API binds to the loopback interface: Caddy is the only public entry
# point and it proxies to 127.0.0.1:4001 on this host. Do NOT use 0.0.0.0
# here - the test instance would be reachable from the whole VPS network,
# bypassing Caddy's TLS.
HOST=127.0.0.1
# One trusted proxy hop (Caddy). Caddy sets X-Forwarded-For, so the real
# client IP only reaches the API when the proxy is trusted. With
# TRUST_PROXY=false every visitor would look like the same IP (127.0.0.1) and
# the rate limiter would lock out the whole test site at once. Never set it
# higher than the real number of proxy hops in front of the API.
TRUST_PROXY=1

# Test database: role ajda_test, database ajda_test.
# The database name MUST end with "_test": deploy/remote-deploy.sh reads it
# from this file and refuses to deploy against any other database.
DATABASE_URL="postgresql://ajda_test:<password>@localhost:5432/ajda_test?schema=public"

# Generate with: openssl rand -base64 32  (a different value than production)
JWT_SECRET="<openssl rand -base64 32>"

CLIENT_ORIGIN="https://ajda.weghetk.com"
APP_URL="https://ajda.weghetk.com"
UPLOAD_DIR="./uploads"
PRIVATE_DIR="./private"
# Redis DB index 1 keeps the test queue isolated from production (DB 0).
# The queue name itself is hardcoded in the app ("ajda-jobs") and cannot be
# prefixed per instance — the database index is the isolation boundary.
REDIS_URL="redis://127.0.0.1:6379/1"
QUEUE_DRIVER="auto"

# Mail is disabled: an empty MAIL_HOST turns every send into a logged no-op,
# so no real mail can ever leave the test instance.
MAIL_HOST=""
MAIL_PORT=587
MAIL_USERNAME=""
MAIL_PASSWORD=""
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=""
MAIL_FROM_NAME="Ajda (test)"
LOGIN_OTP_REQUIRED="false"
NOTIFY_INQUIRY_EMAILS=""

LOG_FILE_PATH="./prod.log"
ERROR_LOG_FILE_PATH="./errors.log"
LOGS_SECRET_KEY="<a value different from production>"
LOGS_PUBLIC="false"
DEVELOPER_NOTES_SECRET="<a value different from production>"

# --- Production Encryption Key ---
# Required in production (the server refuses to boot without it).
# Generate once with: openssl rand -base64 32
# Never change it after anyone enrols TOTP in production — it will make all
# stored authenticator secrets and saved mail passwords unreadable.
# In development it is derived from JWT_SECRET if blank (see secretBox.ts).
SETTINGS_ENCRYPTION_KEY="<openssl rand -base64 32>"
