# ===============================
# Ajda Web — environment example
# Copy to .env.local and adjust.
# NOTE: only VITE_* vars reach the browser bundle.
# ===============================

# --- Google Maps Platform ---
# Browser-restricted key is required (this key ships in client JS by design).
# Restrict it in Google Cloud Console:
#   1. APIs & Services -> Credentials -> Edit key
#   2. Application restrictions -> HTTP referrers (your domains only)
#   3. API restrictions -> Maps JavaScript API (and only what you use)
VITE_GOOGLE_MAPS_API_KEY=""

# Map ID is mandatory for the custom HTML project markers used on the home map.
# Create one: Google Maps Platform -> Map Management -> Create Map ID.
# Leave blank in local dev and the app falls back to Google's DEMO_MAP_ID.
VITE_GOOGLE_MAPS_MAP_ID=""
