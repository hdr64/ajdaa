# ===============================
# Ajda Web — environment example
# Copy to .env.local and adjust.
# NOTE: only VITE_* vars reach the browser bundle.
# ===============================

# --- Production Encryption Key ---
# Required in production (the server refuses to boot without it).
# Generate once with: openssl rand -base64 32
# Never change it after anyone enrols TOTP in production — it will make all
# stored authenticator secrets and saved mail passwords unreadable.
# In development it is derived from JWT_SECRET if blank (see secretBox.ts).
SETTINGS_ENCRYPTION_KEY="<openssl rand -base64 32>"

# Map ID is mandatory for the custom HTML project markers used on the home map.
# Create one: Google Maps Platform -> Map Management -> Create Map ID.
# Leave blank in local dev and the app falls back to Google's DEMO_MAP_ID.
VITE_GOOGLE_MAPS_MAP_ID=""
